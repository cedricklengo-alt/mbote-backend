# ================== MBOTE! Backend ==================
PORT=4000
JWT_SECRET=changez-moi-en-production-svp

# Mode démo : les OTP sont renvoyés dans la réponse API (pas de SMS réel)
# et les appels sont simulés. Passez à false quand Twilio est configuré.
DEMO_MODE=true

# ----- Base de données -----
# Vide → SQLite local (fichier mbote.db, parfait pour le développement).
# Renseignée → PostgreSQL (données permanentes, recommandé en production).
# Exemple Neon.tech : postgresql://user:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/mbote?sslmode=require
DATABASE_URL=

# Mot de passe de la console admin (resynchronisé à chaque démarrage).
# Vide → MboteAdmin2026
ADMIN_PASSWORD=

# ----- FlexPay (optionnel — active les VRAIES recharges Mobile Money) -----
# Agrégateur RDC agréé BCC : M-Pesa, Orange Money, Airtel Money (+ cartes).
# Demandez votre compte marchand sur flexpay.cd (RCCM requis), puis
# remplissez ces 2 valeurs : rien d'autre à changer.
FLEXPAY_MERCHANT=
FLEXPAY_TOKEN=
# URL publique du backend, pour recevoir les webhooks de paiement :
PUBLIC_URL=https://mbote-backend-1.onrender.com

# ----- Reloadly (optionnel — active les VRAIES recharges airtime GSM) -----
# Compte gratuit sur reloadly.com (sans RCCM pour le sandbox).
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true

# ----- Twilio (optionnel — active les VRAIS appels GSM) -----
# Remplissez ces 5 valeurs puis DEMO_MODE=false : rien d'autre à changer.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
